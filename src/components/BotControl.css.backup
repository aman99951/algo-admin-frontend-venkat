.bot-control {
  animation: fadeIn 0.5s ease;
}

.bot-control-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-color);
}

.bot-control-header h2 {
  font-size: 18px;
  font-weight: 600;
}

.init-section {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.init-description {
  color: var(--text-secondary);
  font-size: 14px;
}

.index-selector {
  display: flex;
  gap: 12px;
}

.index-btn {
  flex: 1;
  padding: 12px;
  background: var(--bg-tertiary);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.index-btn:hover {
  border-color: var(--border-hover);
  background: var(--bg-hover);
}

.index-btn.selected {
  border-color: var(--accent-blue);
  background: rgba(33, 150, 243, 0.1);
  color: var(--accent-blue);
}

.bot-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

.bot-empty-state {
  padding: 14px;
  background: var(--bg-secondary);
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  font-size: 13px;
}

.bot-item {
  padding: 16px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: var(--transition);
}

.bot-item:hover {
  border-color: var(--border-hover);
}

.bot-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.bot-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
}

.bot-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text-secondary);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-dot.active {
  background: var(--accent-green);
  box-shadow: 0 0 8px var(--accent-green);
}

.status-dot.inactive {
  background: var(--text-tertiary);
}

.bot-position {
  font-size: 12px;
  color: var(--text-secondary);
}

.position-value {
  font-weight: 600;
  color: var(--text-primary);
}

.bot-actions {
  display: flex;
  gap: 8px;
}

.bot-viz {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border-color);
}

.viz-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6px;
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 600;
}

.viz-sub {
  font-size: 11px;
  color: var(--text-tertiary);
  font-weight: 500;
}

.viz-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.viz-row {
  display: grid;
  grid-template-columns: 92px 1fr 56px;
  align-items: center;
  gap: 8px;
}

.viz-label {
  font-size: 11px;
  color: var(--text-tertiary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.viz-value {
  font-size: 11px;
  color: var(--text-secondary);
  text-align: right;
}

.viz-bar {
  height: 8px;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 999px;
  overflow: hidden;
}

.viz-fill {
  height: 100%;
  background: var(--accent-blue);
}

.viz-fill.green {
  background: var(--accent-green);
}

.viz-fill.blue {
  background: var(--accent-blue);
}

.viz-empty {
  font-size: 11px;
  color: var(--text-tertiary);
}

.viz-locked {
  margin-left: 8px;
  padding: 2px 6px;
  border-radius: 999px;
  border: 1px solid var(--border-color);
  background: var(--bg-secondary);
  color: var(--text-tertiary);
  font-size: 10px;
  font-weight: 600;
}

.btn-sm {
  padding: 8px 16px;
  font-size: 13px;
}

.bot-control-footer {
  display: flex;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--border-color);
}

.bot-control-footer .btn {
  flex: 1;
}

@media (max-width: 768px) {
  .bot-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  
  .bot-actions {
    width: 100%;
  }
  
  .bot-actions .btn {
    flex: 1;
  }
}
