{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://algo-trading-production-5f8c.up.railway.app/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://algo-trading-production-5f8c.up.railway.app/ws/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://algo-trading-production-5f8c.up.railway.app/graphql"
    },
    {
      "source": "/((?!api|ws|graphql|assets|favicon|_next).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
